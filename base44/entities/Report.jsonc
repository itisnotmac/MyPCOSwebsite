{
  "name": "Report",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "community_message",
        "question",
        "answer"
      ]
    },
    "entity_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved"
      ],
      "default": "pending"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "reason"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
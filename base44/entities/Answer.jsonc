{
  "name": "Answer",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "helpful": {
      "type": "boolean",
      "default": false
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar_url": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    }
  },
  "required": [
    "question_id",
    "body",
    "author_name",
    "author_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}